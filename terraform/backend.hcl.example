# Copy to backend.hcl and replace placeholders with your existing OCI Object
# Storage state location. Do not commit backend.hcl.
#
# Authentication credentials must NOT appear in this file.
# For the canonical Cloud Shell workflow, set the non-secret auth selection
# fields below after creating a SecurityToken profile with:
#   oci session authenticate --profile-name tradingchassis --region-id <oci-region>
#
# Backend configuration is distinct from Terraform deployment inputs
# (terraform.tfvars): do not mix compartment, SSH, or Vault values here.
#
# Each independent environment or fork must use a unique key (and normally its
# own prefix). Reusing the same bucket + namespace + key shares one Terraform
# state across unrelated deployments.

bucket    = "<existing-state-bucket>"
namespace = "<object-storage-namespace>"
region    = "<oci-region>"
key       = "tradingchassis/production/terraform.tfstate"

# Non-secret auth selection for the native OCI backend (Cloud Shell canonical path).
# Do not put private keys, tokens, or OCIDs here.
auth                = "SecurityToken"
config_file_profile = "tradingchassis"

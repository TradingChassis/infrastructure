VAULT_ID=<vault-ocid>
OCI_REGION=<oci-region>

# Staging reminder only. Ansible private_runtime_config does not parse this file.
# For Cloud Shell, copy ansible/extra-vars/private-runtime.yml.example to the
# ignored private-runtime.yml and map:
#   VAULT_ID   → private_runtime_config_vault_id
#   OCI_REGION → private_runtime_config_oci_region

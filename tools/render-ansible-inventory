#!/usr/bin/env bash
# Render an operator-local Ansible inventory from Terraform outputs.
# Read-only: does not mutate infrastructure or run playbooks/cluster clients.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: tools/render-ansible-inventory [options]

Reads Terraform outputs and writes an ignored operator-local inventory file.

Options:
  --terraform-dir DIR   Terraform root (default: terraform)
  --output PATH         Inventory path (default: ansible/inventory/local.yml)
  --ssh-user USER       ansible_user (default: ubuntu)
  --ssh-private-key PATH
                        ansible_ssh_private_key_file (default: ~/.ssh/tradingchassis)
  --help                Show this help

Requires terraform outputs:
  instance_public_ip

Does not require a Linux device path. Live paravirtualized OCI attachments
do not materialize oci_core_volume_attachment.device, so Ansible performs
fail-closed automatic scratch-device discovery on the host.

scratch_storage_device_path is an optional explicit override, not a Terraform
handoff. Do not fabricate or hard-code host device names.

Does not embed Vault IDs, OCI regions, backend credentials, or private-key content.
EOF
}

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TF_DIR="${ROOT}/terraform"
OUTPUT="${ROOT}/ansible/inventory/local.yml"
SSH_USER="ubuntu"
SSH_PRIVATE_KEY="${HOME}/.ssh/tradingchassis"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --terraform-dir)
      TF_DIR="$(cd "$2" && pwd)"
      shift 2
      ;;
    --output)
      OUTPUT="$2"
      shift 2
      ;;
    --ssh-user)
      SSH_USER="$2"
      shift 2
      ;;
    --ssh-private-key)
      SSH_PRIVATE_KEY="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if ! command -v terraform >/dev/null 2>&1; then
  echo "error: terraform is required to read outputs" >&2
  exit 1
fi

if [[ ! -d "$TF_DIR" ]]; then
  echo "error: terraform directory not found: $TF_DIR" >&2
  exit 1
fi

raw_output() {
  local name="$1"
  local value
  if ! value="$(terraform -chdir="$TF_DIR" output -raw "$name" 2>/dev/null)"; then
    echo "error: missing or unreadable Terraform output: $name" >&2
    echo "hint: run a successful terraform apply before rendering inventory" >&2
    exit 1
  fi
  if [[ -z "$value" ]]; then
    echo "error: Terraform output $name is empty" >&2
    exit 1
  fi
  printf '%s' "$value"
}

INSTANCE_PUBLIC_IP="$(raw_output instance_public_ip)"

mkdir -p "$(dirname "$OUTPUT")"
umask 077
cat >"$OUTPUT" <<EOF
---
# Generated by tools/render-ansible-inventory. Do not commit.
# Infrastructure handoff only. Private runtime inputs stay in a separate file.
#
# Scratch device identification is Ansible fail-closed auto-discovery.
# Optional explicit override only when intentionally justified:
#   -e scratch_storage_device_path=/operator-verified/path
# First blank-volume converge still requires a separate human format gate:
#   -e scratch_storage_allow_format=true
all:
  children:
    tradingchassis:
      hosts:
        reference-node:
          ansible_host: ${INSTANCE_PUBLIC_IP}
          ansible_user: ${SSH_USER}
          ansible_ssh_private_key_file: ${SSH_PRIVATE_KEY}
EOF

cat <<EOF
Wrote inventory: ${OUTPUT}
ansible_host=${INSTANCE_PUBLIC_IP}
ansible_user=${SSH_USER}
ansible_ssh_private_key_file=${SSH_PRIVATE_KEY}
scratch_device=automatic fail-closed discovery
scratch_storage_device_path=optional explicit override
EOF
